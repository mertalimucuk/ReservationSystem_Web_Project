@page
@model ReservationSystem.Pages.Admin.TermPanelModel 
@{
    ViewData["Title"] = "Academic Term Management";
}


<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h2 class="mb-0"><i class="fas fa-calendar-alt me-2"></i>@ViewData["Title"]</h2>
</div>
<hr class="mb-4" />


@if (TempData["Message"] != null && TempData["MessageType"] != null)
{
    <div class="alert alert-@TempData["MessageType"] alert-dismissible fade show" role="alert">
        @Html.Raw(TempData["Message"])
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


<div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
        <h5 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Add New Term</h5>
    </div>
    <div class="card-body">
        <form method="post" asp-page-handler="Add">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="NewTerm.Name" class="form-label">Term Name</label>
                    <input asp-for="NewTerm.Name" class="form-control" placeholder="e.g., 2024-2025 Spring" required />
                    <span asp-validation-for="NewTerm.Name" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="NewTerm.StartDate" class="form-label">Start Date</label>
                    <input asp-for="NewTerm.StartDate" class="form-control" type="date" required />
                    <span asp-validation-for="NewTerm.StartDate" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="NewTerm.EndDate" class="form-label">End Date</label>
                    <input asp-for="NewTerm.EndDate" class="form-control" type="date" required />
                    <span asp-validation-for="NewTerm.EndDate" class="text-danger"></span>
                </div>
                <div class="col-md-2 d-flex align-items-end pb-1"> 
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" asp-for="NewTerm.IsActive" id="newTermIsActive" />
                        <label class="form-check-label" asp-for="NewTerm.IsActive" for="newTermIsActive">
                            Set Active
                        </label>
                    </div>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-12">
                     <small class="form-text text-muted">
                        <i class="fas fa-info-circle me-1"></i>Activating this term will deactivate any other currently active term.
                    </small>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-12 text-end"> 
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-plus-circle me-2"></i>Add Term
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>


<div class="card shadow-sm">
    <div class="card-header bg-light">
        <h5 class="mb-0"><i class="fas fa-list-ul me-2"></i>Existing Terms</h5>
    </div>
    <div class="card-body p-0">
        @if (Model.Terms != null && Model.Terms.Any()) 
        {
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover mb-0"> 
                    <thead class="table-light"> 
                        <tr>
                            <th>Name</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th class="text-center">Is Active?</th>
                            <th class="text-center" style="width: 150px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var term in Model.Terms)
                        {
                            <tr class="@(term.IsActive ? "table-success" : "")">
                                <td>@term.Name</td>
                                <td>@term.StartDate.ToString("dd MMM yyyy")</td>
                                <td>@term.EndDate.ToString("dd MMM yyyy")</td>
                                <td class="text-center">
                                    @if (term.IsActive)
                                    {
                                        <span class="badge text-bg-success"><i class="fas fa-check-circle me-1"></i>Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary"><i class="fas fa-times-circle me-1"></i>Inactive</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-page="./TermEdit" asp-route-id="@term.Id" class="btn btn-outline-primary" title="Edit Term">
                                            <i class="fas fa-edit me-1"></i>Edit
                                        </a>
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@term.Id" class="d-inline" onsubmit="return confirm('Are you sure you want to delete the term \'@term.Name\'? This action cannot be undone.');">
                                            <button type="submit" class="btn btn-outline-danger" title="Delete Term">
                                                <i class="fas fa-trash-alt me-1"></i>Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info m-3 text-center mb-0">
                <i class="fas fa-info-circle me-2"></i>No academic terms have been added yet. Use the form above to add a new term.
            </div>
        }
    </div>
    @if (Model.Terms != null && Model.Terms.Any()) // Model null kontrolü
    {
        <div class="card-footer text-muted bg-light">
            Total @Model.Terms.Count() terms listed.
        </div>
    }
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
   
}