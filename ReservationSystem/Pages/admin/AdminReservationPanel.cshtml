@page
@model ReservationSystem.Pages.admin.AdminReservationPanelModel 
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Instructor Management"; 
}


<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h2 class="mb-0"><i class="fas fa-users-cog me-2"></i>Instructor Management Panel</h2>
</div>
<hr class="mb-4" />

@if (TempData["Message"] != null)
{
    var messageType = TempData["MessageType"] as string ?? "success"; 
    <div class="alert alert-@messageType alert-dismissible fade show" role="alert">
        @Html.Raw(TempData["Message"]?.ToString())
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


<div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
        <h5 class="mb-0"><i class="fas fa-user-plus me-2"></i>Add New Instructor</h5>
    </div>
    <div class="card-body">
        <form method="post" asp-page-handler="Add">
           
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="NewInstructor.FullName" class="form-label">Full Name</label>
                    <input asp-for="NewInstructor.FullName" class="form-control" placeholder="Enter full name" required />
                    <span asp-validation-for="NewInstructor.FullName" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="NewInstructor.Email" class="form-label">Email</label>
                    <input asp-for="NewInstructor.Email" type="email" class="form-control" placeholder="Enter email address" required />
                    <span asp-validation-for="NewInstructor.Email" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="PlaintextPassword" class="form-label">Password</label>
                    <input asp-for="PlaintextPassword" type="password" class="form-control" placeholder="Enter password" required />
                    <span asp-validation-for="PlaintextPassword" class="text-danger"></span>
                </div>
                <div class="col-12 text-end mt-3">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-plus-circle me-2"></i>Add Instructor</button>
                </div>
            </div>
        </form>
    </div>
</div>


<div class="card shadow-sm">
    <div class="card-header bg-light">
        <h5 class="mb-0"><i class="fas fa-list-ul me-2"></i>Existing Instructors</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Instructors == null || !Model.Instructors.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-3">No instructors found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var instructor in Model.Instructors)
                        {
                            <tr>
                                <td>@instructor.FullName</td>
                                <td>@instructor.Email</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editModal-@instructor.Id">
                                            <i class="fas fa-edit me-1"></i>Edit
                                        </button>
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@instructor.Id" class="d-inline" onsubmit="return confirm('Are you sure you want to delete instructor @instructor.FullName?');">
                                            <button type="submit" class="btn btn-outline-danger">
                                                <i class="fas fa-trash-alt me-1"></i>Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (Model.Instructors != null && Model.Instructors.Any())
    {
        <div class="card-footer bg-light text-muted small">
            Total @Model.Instructors.Count() instructors found.
        </div>
    }
</div>


@if (Model.Instructors != null)
{
    @foreach (var instructor in Model.Instructors)
    {
        <div class="modal fade" id="editModal-@instructor.Id" tabindex="-1" aria-labelledby="editLabel-@instructor.Id" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form method="post" asp-page-handler="Edit">
                        <div class="modal-header">
                            <h5 class="modal-title" id="editLabel-@instructor.Id"><i class="fas fa-user-edit me-2"></i>Edit Instructor: @instructor.FullName</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" name="EditInstructor.Id" value="@instructor.Id" />
                            <div class="mb-3">
                                <label class="form-label">Full Name</label> 
                                <input type="text" name="EditInstructor.FullName" value="@instructor.FullName" class="form-control" required />
                               
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Email</label> 
                                <input type="email" name="EditInstructor.Email" value="@instructor.Email" class="form-control" required />
                                
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label">New Password (Optional)</label>
                                <input type="password" name="EditInstructorPassword" class="form-control" placeholder="Leave blank to keep current password" />
                               
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i>Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}